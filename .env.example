# ── Client (VITE_* is bundled into the browser build — public values only) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=https://www.mothersday.co.il
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=G-RZ3NF8NX21
VITE_INSTAGRAM_URL=
# Client-side checkout flag (the server has its own; set BOTH to enable checkout)
VITE_CHECKOUT_ENABLED=false
# Dev-only fake-payment flow (never enabled in production; server refuses there)
VITE_PAYMENT_SIMULATION_ENABLED=false

# ── Server (Vercel project env — never exposed to the browser) ──
# Supabase service-role key (bypasses RLS; orders/payments only run server-side)
SUPABASE_Secret_KEY=your-service-role-key
# Dedicated secret for guest order-access tokens (do NOT reuse other keys)
ORDER_ACCESS_SECRET=generate-a-long-random-value
# Server-side feature flags (no VITE_ fallback on purpose)
CHECKOUT_ENABLED=false
PAYMENT_SIMULATION_ENABLED=false

# PayPlus (dashboard → API credentials; separate credentials per environment)
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
# Production: https://restapi.payplus.co.il/api/v1.0 (default when unset)
# Staging:    https://restapidev.payplus.co.il/api/v1.0
PAYPLUS_API_BASE=
# Invoice+ documents: "api" (default — we create the invoice right after the
# charge, PayPlus never emails the customer, our email carries the link),
# "auto" (PayPlus generates 1-2 min after charge), "off"
PAYPLUS_INVOICE_MODE=api

# Resend (order confirmation email)
RESEND_API_KEY=your-resend-api-key
ORDER_CONFIRMATION_FROM_EMAIL=יום האם <orders@noreply.mothersday.co.il>
ORDER_CONFIRMATION_REPLY_TO=support@mothersday.co.il
SUPPORT_EMAIL=support@mothersday.co.il
